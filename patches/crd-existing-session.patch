+def is_existing_session_mode():
+  """Returns True if existing-session (mirror) mode is enabled."""
+  return EXISTING_SESSION_ENV_VAR in os.environ
+
+
+def detect_existing_display():
+  """Detect an existing local X display (not a CRD virtual display).
+
+  Scans /tmp/.X11-unix/ for X sockets with display numbers < 20
+  (FIRST_X_DISPLAY_NUMBER), finds a valid Xauthority, and verifies
+  the display is responsive via xdpyinfo.
+
+  Returns:
+    A tuple (display_num, xauthority_path) or None if no display found.
+  """
+  uid = os.getuid()
+  xauth_candidates = [
+      "/run/user/%d/gdm/Xauthority" % uid,
+      os.path.expanduser("~/.Xauthority"),
+  ]
+
+  displays = []
+  socket_dir = "/tmp/.X11-unix"
+  if os.path.isdir(socket_dir):
+    for entry in os.listdir(socket_dir):
+      if entry.startswith("X"):
+        try:
+          num = int(entry[1:])
+          if num < FIRST_X_DISPLAY_NUMBER:
+            displays.append(num)
+        except ValueError:
+          pass
+  displays.sort()
+
+  for display_num in displays:
+    for xauth in xauth_candidates:
+      if not os.path.exists(xauth):
+        continue
+      env = dict(os.environ)
+      env["DISPLAY"] = ":%d" % display_num
+      env["XAUTHORITY"] = xauth
+      try:
+        ret = subprocess.call(
+            ["xdpyinfo"], env=env,
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+            timeout=5)
+        if ret == 0:
+          logging.info(
+              "Existing session mode: found display :%d with Xauthority %s",
+              display_num, xauth)
+          return (display_num, xauth)
+      except (subprocess.TimeoutExpired, Exception) as e:
+        logging.debug("xdpyinfo :%d with %s failed: %s",
+                      display_num, xauth, e)
+
+  return None
+
+
